# ─── Supabase ────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Usado apenas no servidor (Server Actions, Route Handlers)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Banco de Dados (Prisma) ──────────────────────────────────────
# Connection pooling via pgBouncer (Transaction mode) — para queries em runtime
# Supabase Dashboard → Settings → Database → Connection String (Transaction)
DATABASE_URL=postgresql://postgres.xxxxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Conexão direta — usada pelo Prisma Migrate
# Supabase Dashboard → Settings → Database → Connection String (Session)
DIRECT_URL=postgresql://postgres.xxxxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Segurança ────────────────────────────────────────────────────
# Secret usado no HMAC do QR Hash do ingresso — mude em produção!
TICKET_SECRET_HASH=change-me-to-a-random-64-char-string

# ─── Asaas (Fase 2) ───────────────────────────────────────────────
# Gere sua chave em: https://sandbox.asaas.com → Configurações → Integrações
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
# Use "sandbox" ou "production"
ASAAS_ENV=sandbox
