{
  "name": "ticket-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e:server": "node test/e2e/local-server.mjs",
    "test:e2e:http": "node --test test/e2e/http.test.mjs",
    "test:e2e:stop": "node test/e2e/local-server.mjs --stop",
    "test:browser": "node test/browser/run.mjs",
    "local:up": "node scripts/local.mjs up",
    "local:status": "node scripts/local.mjs status",
    "local:down": "node scripts/local.mjs down",
    "check:ui": "node scripts/check-icon-controls.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.34.0",
    "mapbox-gl": "^3.32.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.4",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "12.2.1",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^24",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "nock": "15.0.6",
    "prisma": "5.22.0",
    "supabase": "3.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
